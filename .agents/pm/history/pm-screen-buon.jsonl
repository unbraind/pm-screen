{"hash_algorithm":"sha256","ts":"2026-11-09T12:57:46.112Z","author":"harness:claude-code","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"8bca0b4be72a52f0b6f99b13","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.319","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-screen-buon"},{"op":"add","path":"/metadata/title","value":"Refuse sparse arrays longer than the traversal budget before schema validation"},{"op":"add","path":"/metadata/description","value":"guardSubmitted bounded visited entries but not array length, so a sparse new Array(2 ** 31) passed the guard and schema validation would iterate every empty slot before the schema's max check. Same class CodeRabbit raised on pm-reduce (fixed there in bf3dff0); pm-case and pm-glossary already bound array length."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"in_progress"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["dos","input-guard","privacy"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-09T12:57:46.112Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-09T12:57:46.112Z"},{"op":"add","path":"/metadata/assignee","value":"harness:claude-code"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Arrays longer than 32768 are refused with invalid_input before validation; a regression covers 2^31 and 32769 (refused) and 64 (allowed) and fails on revert."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"467ad5dc4cfc6706bde897ab3c8c56fd368da0471b491b11d57e278921081170","item_hash_version":